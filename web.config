<?xml version="1.0" encoding="UTF-8"?>
<!-- Only used when the game is served by IIS (for example alongside a DotNetNuke site). GitHub Pages ignores it.
     It lets IIS serve the .webp emblem images and opens index.html when the folder's address is visited. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
    </staticContent>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
